--
-- ora_timestamptz regression tests
--
SET TimeZone = 'Europe/Berlin';
CREATE EXTENSION ora_timestamptz;
SET ora_timestamptz.nls_timestamp_tz_format = 'DD-MON-RR HH.MI.SSXFF AM TZR';
-- input forms: region, offset, RFC 9557, region + TZD, session zone
SELECT '2026-10-16 14:30:00 Europe/Berlin'::ora_timestamptz;
                 ora_timestamptz                 
-------------------------------------------------
 2026-10-16 14:30:00.000000+02:00[Europe/Berlin]
(1 row)

SELECT '2026-10-16 14:30:00.123 +05:30'::ora_timestamptz;
         ora_timestamptz          
----------------------------------
 2026-10-16 14:30:00.123000+05:30
(1 row)

SELECT '2026-10-16T14:30:00+02:00[Europe/Berlin]'::ora_timestamptz;
                 ora_timestamptz                 
-------------------------------------------------
 2026-10-16 14:30:00.000000+02:00[Europe/Berlin]
(1 row)

SELECT '2026-10-16T14:30:00Z'::ora_timestamptz;
         ora_timestamptz          
----------------------------------
 2026-10-16 14:30:00.000000+00:00
(1 row)

SELECT '2026-10-16 14:30:00 UTC'::ora_timestamptz;
            ora_timestamptz            
---------------------------------------
 2026-10-16 14:30:00.000000+00:00[UTC]
(1 row)

SELECT '2026-10-16 14:30'::ora_timestamptz;
                 ora_timestamptz                 
-------------------------------------------------
 2026-10-16 14:30:00.000000+02:00[Europe/Berlin]
(1 row)

SELECT '2026-10-16'::ora_timestamptz;
                 ora_timestamptz                 
-------------------------------------------------
 2026-10-16 00:00:00.000000+02:00[Europe/Berlin]
(1 row)

SELECT '2026-10-16 14:30 europe/berlin'::ora_timestamptz;
                 ora_timestamptz                 
-------------------------------------------------
 2026-10-16 14:30:00.000000+02:00[Europe/Berlin]
(1 row)

SELECT '2026-10-16 14:30:00-0330'::ora_timestamptz;
         ora_timestamptz          
----------------------------------
 2026-10-16 14:30:00.000000-03:30
(1 row)

SELECT '2026-10-16 14:30:00 +02:00 Europe/Berlin'::ora_timestamptz;
                 ora_timestamptz                 
-------------------------------------------------
 2026-10-16 14:30:00.000000+02:00[Europe/Berlin]
(1 row)

-- invalid input
SELECT '2026-10-16 14:30 Mars/Olympus'::ora_timestamptz;
ERROR:  time zone "Mars/Olympus" not recognized
LINE 1: SELECT '2026-10-16 14:30 Mars/Olympus'::ora_timestamptz;
               ^
HINT:  Use an offset like '+02:00' or an IANA region like 'Europe/Berlin' (Oracle ORA-01882).
SELECT '2026-02-29 14:30 UTC'::ora_timestamptz;
ERROR:  day of month must be between 1 and last day of month (Oracle ORA-01847)
LINE 1: SELECT '2026-02-29 14:30 UTC'::ora_timestamptz;
               ^
SELECT '2026-10-16 24:00 UTC'::ora_timestamptz;
ERROR:  time field out of range (Oracle ORA-01850/01851/01852)
LINE 1: SELECT '2026-10-16 24:00 UTC'::ora_timestamptz;
               ^
SELECT '2026-10-16 14:30 +15:00'::ora_timestamptz;
ERROR:  time zone offset out of range
LINE 1: SELECT '2026-10-16 14:30 +15:00'::ora_timestamptz;
               ^
DETAIL:  Oracle allows offsets from -12:59 to +14:59 (ORA-01874).
SELECT '2026-10-16 14:30:00.1234567891 UTC'::ora_timestamptz;
ERROR:  invalid input syntax for type ora_timestamptz: "2026-10-16 14:30:00.1234567891 UTC"
LINE 1: SELECT '2026-10-16 14:30:00.1234567891 UTC'::ora_timestamptz...
               ^
DETAIL:  more than 9 fractional second digits
HINT:  Expected 'YYYY-MM-DD HH24:MI:SS[.FF] zone' (zone: '+HH:MI', 'Region [TZD]', '+HH:MI[Region]') or the format in ora_timestamptz.nls_timestamp_tz_format.
SELECT pg_input_is_valid('garbage', 'ora_timestamptz');
 pg_input_is_valid 
-------------------
 f
(1 row)

SELECT pg_input_is_valid('2026-10-16 14:30 UTC', 'ora_timestamptz');
 pg_input_is_valid 
-------------------
 t
(1 row)

-- Oracle: values are equal if they denote the same instant
SELECT '1999-01-15 8:00:00 -8:00'::ora_timestamptz = '1999-01-15 11:00:00 -5:00'::ora_timestamptz;
 ?column? 
----------
 t
(1 row)

SELECT ora_timestamptz_identical('1999-01-15 8:00:00 -8:00', '1999-01-15 11:00:00 -5:00');
 ora_timestamptz_identical 
---------------------------
 f
(1 row)

SELECT '2026-10-16 12:00 UTC'::ora_timestamptz < '2026-10-16 14:00:01 Europe/Berlin'::ora_timestamptz;
 ?column? 
----------
 t
(1 row)

-- DST gap (ORA-01878) and overlap
SELECT '2026-03-29 02:30:00 Europe/Berlin'::ora_timestamptz;
ERROR:  local time 2026-03-29 02:30:00 does not exist in time zone "Europe/Berlin"
LINE 1: SELECT '2026-03-29 02:30:00 Europe/Berlin'::ora_timestamptz;
               ^
DETAIL:  The time falls into a daylight saving time gap (Oracle ORA-01878).
SELECT '2026-10-25 02:30:00 Europe/Berlin'::ora_timestamptz;
                 ora_timestamptz                 
-------------------------------------------------
 2026-10-25 02:30:00.000000+01:00[Europe/Berlin]
(1 row)

SELECT '2026-10-25 02:30:00 Europe/Berlin CEST'::ora_timestamptz;
                 ora_timestamptz                 
-------------------------------------------------
 2026-10-25 02:30:00.000000+02:00[Europe/Berlin]
(1 row)

SELECT '2026-10-25 02:30:00 Europe/Berlin CET'::ora_timestamptz;
                 ora_timestamptz                 
-------------------------------------------------
 2026-10-25 02:30:00.000000+01:00[Europe/Berlin]
(1 row)

SELECT '2026-10-25 02:30:00+02:00[Europe/Berlin]'::ora_timestamptz;
                 ora_timestamptz                 
-------------------------------------------------
 2026-10-25 02:30:00.000000+02:00[Europe/Berlin]
(1 row)

SELECT '2026-10-25 02:30:00 Europe/Berlin PDT'::ora_timestamptz;
ERROR:  time zone abbreviation "PDT" does not match time zone region "Europe/Berlin" at the given local time
LINE 1: SELECT '2026-10-25 02:30:00 Europe/Berlin PDT'::ora_timestam...
               ^
DETAIL:  Oracle ORA-01857.
SELECT '2026-10-25 02:30:00+05:00[Europe/Berlin]'::ora_timestamptz;
ERROR:  UTC offset does not match time zone region "Europe/Berlin" at the given local time
LINE 1: SELECT '2026-10-25 02:30:00+05:00[Europe/Berlin]'::ora_times...
               ^
SET ora_timestamptz.error_on_overlap_time = on;
SELECT '2026-10-25 02:30:00 Europe/Berlin'::ora_timestamptz;
ERROR:  ambiguous local time in time zone "Europe/Berlin"
LINE 1: SELECT '2026-10-25 02:30:00 Europe/Berlin'::ora_timestamptz;
               ^
DETAIL:  The time falls into a daylight saving time overlap (Oracle ORA-01883).
HINT:  Add a time zone abbreviation (TZD) or a UTC offset to disambiguate.
SELECT '2026-10-25 02:30:00 Europe/Berlin CEST'::ora_timestamptz;
                 ora_timestamptz                 
-------------------------------------------------
 2026-10-25 02:30:00.000000+02:00[Europe/Berlin]
(1 row)

RESET ora_timestamptz.error_on_overlap_time;
-- precision (typmod), rounding like Oracle
SELECT '2026-10-16 14:30:00.123456789 UTC'::ora_timestamptz;
             ora_timestamptz              
------------------------------------------
 2026-10-16 14:30:00.123456789+00:00[UTC]
(1 row)

SELECT '2026-10-16 14:30:00.123456789 UTC'::ora_timestamptz(9);
             ora_timestamptz              
------------------------------------------
 2026-10-16 14:30:00.123456789+00:00[UTC]
(1 row)

SELECT '2026-10-16 14:30:00.123456789 UTC'::ora_timestamptz(3);
          ora_timestamptz           
------------------------------------
 2026-10-16 14:30:00.123+00:00[UTC]
(1 row)

SELECT '2026-10-16 23:59:59.9999 UTC'::ora_timestamptz(0);
        ora_timestamptz         
--------------------------------
 2026-10-17 00:00:00+00:00[UTC]
(1 row)

SELECT '2026-10-16 14:30:00.5 UTC'::ora_timestamptz::ora_timestamptz(0);
        ora_timestamptz         
--------------------------------
 2026-10-16 14:30:01+00:00[UTC]
(1 row)

SELECT 'x'::text::ora_timestamptz(10);
ERROR:  ora_timestamptz(10) precision must be between 0 and 9
LINE 1: SELECT 'x'::text::ora_timestamptz(10);
                          ^
CREATE TABLE t (id int, ts ora_timestamptz(3));
\d t
                       Table "public.t"
 Column |        Type        | Collation | Nullable | Default 
--------+--------------------+-----------+----------+---------
 id     | integer            |           |          | 
 ts     | ora_timestamptz(3) |           |          | 

INSERT INTO t VALUES (1, '2026-10-16 14:30:00.123456 Europe/Berlin');
SELECT * FROM t;
 id |                      ts                      
----+----------------------------------------------
  1 | 2026-10-16 14:30:00.123+02:00[Europe/Berlin]
(1 row)

-- arithmetic in UTC (Oracle doc example 4-6: DST end in New York)
SELECT '2000-10-28 23:24:54 America/New_York'::ora_timestamptz(0) + interval '8 hours';
                  ?column?                   
---------------------------------------------
 2000-10-29 06:24:54-05:00[America/New_York]
(1 row)

SELECT '2026-03-28 12:00 Europe/Berlin'::ora_timestamptz + interval '1 day';
                    ?column?                     
-------------------------------------------------
 2026-03-29 13:00:00.000000+02:00[Europe/Berlin]
(1 row)

SELECT interval '1 hour' + '2026-10-16 14:30 +05:30'::ora_timestamptz;
             ?column?             
----------------------------------
 2026-10-16 15:30:00.000000+05:30
(1 row)

SELECT '2026-10-16 14:30 Europe/Berlin'::ora_timestamptz - interval '1 month';
                    ?column?                     
-------------------------------------------------
 2026-09-16 14:30:00.000000+02:00[Europe/Berlin]
(1 row)

SELECT '2026-01-31 10:00 UTC'::ora_timestamptz + interval '1 month';
ERROR:  date not valid for month specified
DETAIL:  Oracle ORA-01839: month arithmetic does not clamp to the last day of the month; it is evaluated in UTC.
SELECT '2026-10-16 14:30 Europe/Berlin'::ora_timestamptz - '2026-10-10 10:00 UTC'::ora_timestamptz;
         ?column?         
--------------------------
 @ 6 days 2 hours 30 mins
(1 row)

SELECT '2026-10-10 10:00 UTC'::ora_timestamptz - '2026-10-16 14:30:00.5 Europe/Berlin'::ora_timestamptz;
               ?column?                
---------------------------------------
 @ 6 days 2 hours 30 mins 0.5 secs ago
(1 row)

SELECT '2026-10-16 14:30 UTC'::ora_timestamptz + interval '0.000001 sec';
               ?column?                
---------------------------------------
 2026-10-16 14:30:00.000001+00:00[UTC]
(1 row)

SELECT '2026-10-16 14:30 UTC'::ora_timestamptz + 'infinity'::interval;
ERROR:  cannot add infinite interval to ora_timestamptz
