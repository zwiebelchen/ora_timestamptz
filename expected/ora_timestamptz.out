ERROR:  local time 2026-03-29 02:30:00 does not exist in time zone "Europe/Berlin"
DETAIL:  The time falls into a daylight saving time gap (Oracle ORA-01878).
BEGIN;
INSERT INTO t VALUES (2, now());
SELECT ts = now()::ora_timestamptz(3) FROM t WHERE id = 2;
 ?column? 
----------
 t
